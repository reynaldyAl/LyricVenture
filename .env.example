# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

SPOTIFY_CLIENT_ID=...
SPOTIFY_CLIENT_SECRET=...

# (optional) Server-side service role — jangan dipakai di client
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ── Cron Jobs ──────────────────────────────────────────────────────────────
# Secret untuk mengamankan endpoint /api/cron/*
# Generate dengan: openssl rand -base64 32
# Atau: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Tambahkan juga ke GitHub Actions Secrets sebagai CRON_SECRET
CRON_SECRET=your_random_secret_here

# URL production untuk GitHub Actions cron trigger
# Contoh: https://lyric-venture.vercel.app atau https://yourdomain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000